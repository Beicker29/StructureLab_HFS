{
  "$comment": "Finite JSON only. Validate with steel_design.contracts for canonical cross-field and derived/evidence integrity. Dynamic details are opaque JSON, not an accredited normative trace.",
  "$defs": {
    "AngleCompressionMode": {
      "enum": [
        "one_leg",
        "both_legs"
      ],
      "title": "AngleCompressionMode",
      "type": "string"
    },
    "AngleFlexureAxis": {
      "enum": [
        "major_principal",
        "geometric_axis"
      ],
      "title": "AngleFlexureAxis",
      "type": "string"
    },
    "AngleLtbRestraint": {
      "enum": [
        "continuous",
        "discrete_unbraced",
        "max_moment_only"
      ],
      "title": "AngleLtbRestraint",
      "type": "string"
    },
    "AngleMaxTensionLocation": {
      "enum": [
        "toe",
        "heel"
      ],
      "title": "AngleMaxTensionLocation",
      "type": "string"
    },
    "CompositeAnchorGroup": {
      "additionalProperties": false,
      "properties": {
        "Fu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stud ultimate tensile strength (MPa)",
          "title": "Fu"
        },
        "Rg": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deck geometry reduction factor for stud anchors",
          "title": "Rg"
        },
        "Rp": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deck position reduction factor for stud anchors",
          "title": "Rp"
        },
        "count": {
          "description": "Number of anchors in this group",
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "d": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stud shank diameter (mm)",
          "title": "D"
        },
        "la": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Channel anchor length (mm)",
          "title": "La"
        },
        "segment": {
          "$ref": "#/$defs/CompositeAnchorSegment",
          "default": "positive",
          "description": "Span segment associated with this anchor group."
        },
        "tf": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Channel flange thickness (mm)",
          "title": "Tf"
        },
        "tw": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Channel web thickness (mm)",
          "title": "Tw"
        },
        "type": {
          "$ref": "#/$defs/CompositeAnchorType"
        }
      },
      "required": [
        "type",
        "count"
      ],
      "title": "CompositeAnchorGroup",
      "type": "object"
    },
    "CompositeAnchorSegment": {
      "enum": [
        "positive",
        "negative"
      ],
      "title": "CompositeAnchorSegment",
      "type": "string"
    },
    "CompositeAnchorType": {
      "enum": [
        "STUD",
        "CHANNEL"
      ],
      "title": "CompositeAnchorType",
      "type": "string"
    },
    "CompositeAnchors": {
      "additionalProperties": false,
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/$defs/CompositeAnchorGroup"
          },
          "title": "Groups",
          "type": "array"
        }
      },
      "title": "CompositeAnchors",
      "type": "object"
    },
    "CompositeConcrete": {
      "additionalProperties": false,
      "properties": {
        "fc": {
          "description": "Specified compressive strength of concrete (MPa)",
          "exclusiveMinimum": 0,
          "title": "Fc",
          "type": "number"
        },
        "wc": {
          "description": "Concrete unit weight (kg/m3)",
          "exclusiveMinimum": 0,
          "title": "Wc",
          "type": "number"
        }
      },
      "required": [
        "fc",
        "wc"
      ],
      "title": "CompositeConcrete",
      "type": "object"
    },
    "CompositeConfig": {
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "$ref": "#/$defs/CompositeAnchors"
        },
        "concrete": {
          "$ref": "#/$defs/CompositeConcrete"
        },
        "geometry": {
          "$ref": "#/$defs/CompositeGeometry"
        },
        "i5": {
          "$ref": "#/$defs/CompositeI5Config"
        },
        "nominal_strength_method": {
          "$ref": "#/$defs/CompositeNominalStrengthMethod"
        },
        "reinforcement": {
          "$ref": "#/$defs/CompositeReinforcement"
        },
        "role": {
          "$ref": "#/$defs/CompositeRole"
        }
      },
      "required": [
        "role",
        "nominal_strength_method",
        "concrete"
      ],
      "title": "CompositeConfig",
      "type": "object"
    },
    "CompositeGeometry": {
      "additionalProperties": false,
      "properties": {
        "B": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overall composite width for encased members (mm)",
          "title": "B"
        },
        "H": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overall composite depth for encased members (mm)",
          "title": "H"
        },
        "cover": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concrete cover to reinforcement (mm)",
          "title": "Cover"
        },
        "deck_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether formed steel deck is present.",
          "title": "Deck Present"
        },
        "slab_effective_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Effective slab width for composite beam (mm)",
          "title": "Slab Effective Width"
        },
        "slab_thickness": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Slab thickness for composite beam (mm)",
          "title": "Slab Thickness"
        }
      },
      "title": "CompositeGeometry",
      "type": "object"
    },
    "CompositeI5Config": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/$defs/CompositeI5Method",
          "default": "METHOD_1_H1_1",
          "description": "Commentary I5 method selector."
        },
        "method2_mc_ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional M_C/M_B ratio for Method 2 when not inferred (0 < ratio).",
          "title": "Method2 Mc Ratio"
        },
        "method2_pc_ratio": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional P_C/P_A ratio for Method 2 when not inferred (0 < ratio < 1).",
          "title": "Method2 Pc Ratio"
        }
      },
      "title": "CompositeI5Config",
      "type": "object"
    },
    "CompositeI5Method": {
      "enum": [
        "METHOD_1_H1_1",
        "METHOD_2_PLASTIC_INTERACTION",
        "METHOD_4_DIRECT_INTERACTION"
      ],
      "title": "CompositeI5Method",
      "type": "string"
    },
    "CompositeLongitudinalBar": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "description": "Number of bars at this coordinate",
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "db": {
          "description": "Bar diameter (mm)",
          "exclusiveMinimum": 0,
          "title": "Db",
          "type": "number"
        },
        "fy": {
          "description": "Bar yield stress (MPa)",
          "exclusiveMinimum": 0,
          "title": "Fy",
          "type": "number"
        },
        "x": {
          "description": "Bar x coordinate from composite centroid (mm)",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "Bar y coordinate from composite centroid (mm)",
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "count",
        "db",
        "fy",
        "x",
        "y"
      ],
      "title": "CompositeLongitudinalBar",
      "type": "object"
    },
    "CompositeNominalStrengthMethod": {
      "enum": [
        "PLASTIC",
        "STRAIN_COMPAT",
        "ELASTIC",
        "EFFECTIVE_STRAIN"
      ],
      "title": "CompositeNominalStrengthMethod",
      "type": "string"
    },
    "CompositeReinforcement": {
      "additionalProperties": false,
      "properties": {
        "longitudinal_bars": {
          "description": "Longitudinal reinforcement layout.",
          "items": {
            "$ref": "#/$defs/CompositeLongitudinalBar"
          },
          "title": "Longitudinal Bars",
          "type": "array"
        },
        "transverse": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompositeTransverseReinforcement"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum transverse reinforcement definition."
        }
      },
      "title": "CompositeReinforcement",
      "type": "object"
    },
    "CompositeRole": {
      "enum": [
        "ENCASED_MEMBER",
        "FILLED_MEMBER",
        "COMPOSITE_BEAM"
      ],
      "title": "CompositeRole",
      "type": "string"
    },
    "CompositeTransverseReinforcement": {
      "additionalProperties": false,
      "properties": {
        "db": {
          "description": "Transverse bar diameter (mm)",
          "exclusiveMinimum": 0,
          "title": "Db",
          "type": "number"
        },
        "fy": {
          "description": "Yield stress (MPa)",
          "exclusiveMinimum": 0,
          "title": "Fy",
          "type": "number"
        },
        "spacing": {
          "description": "Spacing (mm)",
          "exclusiveMinimum": 0,
          "title": "Spacing",
          "type": "number"
        },
        "type": {
          "description": "Transverse reinforcement type (ties/hoops/spirals/stirrups)",
          "enum": [
            "ties",
            "hoops",
            "spirals",
            "stirrups"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "db",
        "spacing",
        "fy",
        "type"
      ],
      "title": "CompositeTransverseReinforcement",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "An": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Net area for tension rupture (mm^2)",
          "title": "An"
        },
        "U": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shear lag factor for tension rupture (0 < U <= 1)",
          "title": "U"
        },
        "angle_compression_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/AngleCompressionMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Connection mode for single-angle compression (E5)."
        },
        "angle_flexure_axis": {
          "anyOf": [
            {
              "$ref": "#/$defs/AngleFlexureAxis"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Single-angle flexure axis definition for F10."
        },
        "angle_ltb_restraint": {
          "anyOf": [
            {
              "$ref": "#/$defs/AngleLtbRestraint"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lateral-torsional restraint condition for F10."
        },
        "angle_max_tension_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/AngleMaxTensionLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Location of maximum tension for geometric-axis bending in F10."
        }
      },
      "title": "Connection",
      "type": "object"
    },
    "CustomSection": {
      "additionalProperties": false,
      "properties": {
        "B": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Width for solid rectangular section (mm)",
          "title": "B"
        },
        "H": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Height for solid rectangular section (mm)",
          "title": "H"
        },
        "diameter": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Diameter for solid circular section (mm)",
          "title": "Diameter"
        },
        "type": {
          "$ref": "#/$defs/CustomSectionType"
        }
      },
      "required": [
        "type"
      ],
      "title": "CustomSection",
      "type": "object"
    },
    "CustomSectionType": {
      "enum": [
        "SOLID_CIRCULAR",
        "SOLID_RECTANGULAR"
      ],
      "title": "CustomSectionType",
      "type": "string"
    },
    "DesignMethod": {
      "enum": [
        "LRFD",
        "ASD"
      ],
      "title": "DesignMethod",
      "type": "string"
    },
    "Factors": {
      "additionalProperties": false,
      "properties": {
        "Cb": {
          "default": 1.0,
          "description": "Lateral-torsional buckling modification factor",
          "exclusiveMinimum": 0,
          "title": "Cb",
          "type": "number"
        },
        "Kx": {
          "default": 1.0,
          "description": "Effective length factor for strong axis",
          "exclusiveMinimum": 0,
          "title": "Kx",
          "type": "number"
        },
        "Ky": {
          "default": 1.0,
          "description": "Effective length factor for weak axis",
          "exclusiveMinimum": 0,
          "title": "Ky",
          "type": "number"
        },
        "Kz": {
          "default": 1.0,
          "description": "Effective length factor for torsional/flexural-torsional buckling axis",
          "exclusiveMinimum": 0,
          "title": "Kz",
          "type": "number"
        },
        "xa": {
          "default": 0.0,
          "description": "Bracing offset distance along x-axis (mm)",
          "minimum": 0,
          "title": "Xa",
          "type": "number"
        },
        "ya": {
          "default": 0.0,
          "description": "Bracing offset distance along y-axis (mm)",
          "minimum": 0,
          "title": "Ya",
          "type": "number"
        }
      },
      "title": "Factors",
      "type": "object"
    },
    "Lengths": {
      "additionalProperties": false,
      "properties": {
        "Lb": {
          "description": "Unbraced length for lateral-torsional buckling (mm)",
          "exclusiveMinimum": 0,
          "title": "Lb",
          "type": "number"
        },
        "Lx": {
          "description": "Unbraced length for strong axis buckling (mm)",
          "exclusiveMinimum": 0,
          "title": "Lx",
          "type": "number"
        },
        "Ly": {
          "description": "Unbraced length for weak axis buckling (mm)",
          "exclusiveMinimum": 0,
          "title": "Ly",
          "type": "number"
        },
        "Lz": {
          "description": "Unbraced length for torsional/flexural-torsional buckling (mm)",
          "exclusiveMinimum": 0,
          "title": "Lz",
          "type": "number"
        }
      },
      "required": [
        "Lx",
        "Ly",
        "Lz",
        "Lb"
      ],
      "title": "Lengths",
      "type": "object"
    },
    "Loads": {
      "additionalProperties": false,
      "properties": {
        "Mux": {
          "default": 0.0,
          "description": "Required flexural strength, major-axis (kN-m)",
          "title": "Mux",
          "type": "number"
        },
        "Muy": {
          "default": 0.0,
          "description": "Required flexural strength, minor-axis (kN-m)",
          "title": "Muy",
          "type": "number"
        },
        "Pu": {
          "default": 0.0,
          "description": "Required axial strength (kN). Positive is compression.",
          "title": "Pu",
          "type": "number"
        },
        "Tu": {
          "default": 0.0,
          "description": "Required torsional strength (kN-m)",
          "title": "Tu",
          "type": "number"
        },
        "Vu": {
          "default": 0.0,
          "description": "Legacy scalar alias of Vux (local-y force, kN), never a vector resultant",
          "title": "Vu",
          "type": "number"
        },
        "Vux": {
          "default": 0.0,
          "description": "Shear associated with major-axis Mux, force along local y (kN); suffix names bending plane",
          "title": "Vux",
          "type": "number"
        },
        "Vuy": {
          "default": 0.0,
          "description": "Shear associated with minor-axis Muy, force along local x (kN); suffix names bending plane",
          "title": "Vuy",
          "type": "number"
        }
      },
      "title": "Loads",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "properties": {
        "E": {
          "default": 200000.0,
          "description": "Elastic modulus (MPa)",
          "exclusiveMinimum": 0,
          "title": "E",
          "type": "number"
        },
        "Fu": {
          "description": "Ultimate tensile strength (MPa)",
          "exclusiveMinimum": 0,
          "title": "Fu",
          "type": "number"
        },
        "Fy": {
          "description": "Yield strength (MPa)",
          "exclusiveMinimum": 0,
          "title": "Fy",
          "type": "number"
        }
      },
      "required": [
        "Fy",
        "Fu"
      ],
      "title": "Material",
      "type": "object"
    },
    "SlendernessAdviceBasis": {
      "additionalProperties": false,
      "description": "Optional external facts for User Notes, never resistance/coverage inputs.",
      "properties": {
        "fabricated_length": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fabricated member length (mm), not unbraced length",
          "title": "Fabricated Length"
        },
        "is_rod": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether the D1 rod exception applies; absent means unknown",
          "title": "Is Rod"
        },
        "least_radius": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Least section radius of gyration (mm), including principal axes",
          "title": "Least Radius"
        }
      },
      "title": "SlendernessAdviceBasis",
      "type": "object"
    },
    "TensionScope": {
      "additionalProperties": false,
      "description": "External basis for the narrow ordinary solid-tie scope (HFS-010).\n\nNone is unknown. References are supplied evidence, not authenticated here.",
      "properties": {
        "concentric_axial_force": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concentric Axial Force"
        },
        "connection_reference": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connection Reference"
        },
        "demand_reference": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Demand Reference"
        },
        "external_checks_reference": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Checks Reference"
        },
        "material_reference": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Reference"
        },
        "net_area_reference": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Net Area Reference"
        },
        "no_special_conditions": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "No Special Conditions"
        },
        "ordinary_prismatic_member": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordinary Prismatic Member"
        }
      },
      "title": "TensionScope",
      "type": "object"
    }
  },
  "$id": "urn:structurelab-hfs:contracts:1.0:case_input:validation",
