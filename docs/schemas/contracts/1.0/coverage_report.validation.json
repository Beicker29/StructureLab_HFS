{
  "$comment": "Finite JSON only. Validate with steel_design.contracts for canonical cross-field and derived/evidence integrity. Dynamic details are opaque JSON, not an accredited normative trace.",
  "$defs": {
    "CoverageObligation": {
      "additionalProperties": false,
      "properties": {
        "accepted_checks": {
          "items": {
            "type": "integer"
          },
          "title": "Accepted Checks",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "applicability": {
          "default": "TRUE",
          "enum": [
            "TRUE",
            "FALSE",
            "UNKNOWN"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "component": {
          "title": "Component",
          "type": "string"
        },
        "condition": {
          "title": "Condition",
          "type": "string"
        },
        "executed_checks": {
          "items": {
            "type": "integer"
          },
          "title": "Executed Checks",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "limit_state": {
          "title": "Limit State",
          "type": "string"
        },
        "normative_ids": {
          "items": {
            "type": "string"
          },
          "title": "Normative Ids",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "required": {
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        },
        "resistance": {
          "default": true,
          "title": "Resistance",
          "type": "boolean"
        },
        "selected_alternative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Alternative"
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus",
          "default": "PENDING"
        }
      },
      "required": [
        "id",
        "normative_ids",
        "limit_state",
        "component",
        "condition",
        "applicability",
        "status",
        "reason",
        "required",
        "alternatives",
        "selected_alternative",
        "executed_checks",
        "accepted_checks",
        "resistance"
      ],
      "title": "CoverageObligation",
      "type": "object"
    },
    "CoverageStatus": {
      "enum": [
        "EVALUATED",
        "NOT_APPLICABLE",
        "PENDING"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "ExecutedEvaluation": {
      "additionalProperties": false,
      "properties": {
        "check_index": {
          "title": "Check Index",
          "type": "integer"
        },
        "implementation": {
          "title": "Implementation",
          "type": "string"
        },
        "obligation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Obligation Ids",
          "type": "array"
        }
      },
      "required": [
        "check_index",
        "implementation",
        "obligation_ids"
      ],
      "title": "ExecutedEvaluation",
      "type": "object"
    }
  },
  "$id": "urn:structurelab-hfs:contracts:1.0:coverage_report:validation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "type": "string"
    },
    "kind": {
      "const": "coverage_report",
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "readOnly": true,
          "title": "Complete",
          "type": "boolean"
        },
        "declared_scope": {
          "default": "Member resistance for every supplied demand component; no global AISC certification",
          "title": "Declared Scope",
          "type": "string"
        },
        "demand_components": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Demand Components",
          "type": "object"
        },
        "evaluation_context": {
          "default": "One supplied member/load case; no position, combination or construction-stage envelope is inferred",
          "title": "Evaluation Context",
          "type": "string"
        },
        "evaluation_errors": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Evaluation Errors",
          "type": "array"
        },
        "executions": {
          "items": {
            "$ref": "#/$defs/ExecutedEvaluation"
          },
          "title": "Executions",
          "type": "array"
        },
        "external_responsibilities": {
          "items": {
            "type": "string"
          },
          "title": "External Responsibilities",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "obligations": {
          "items": {
            "$ref": "#/$defs/CoverageObligation"
          },
          "title": "Obligations",
          "type": "array"
        },
        "profile_type": {
          "title": "Profile Type",
          "type": "string"
        },
        "scope_evidence": {
          "additionalProperties": true,
          "title": "Scope Evidence",
          "type": "object"
        },
        "section_name": {
          "title": "Section Name",
          "type": "string"
        },
        "source": {
          "default": "docs/normative/hfs002-applicability.md (S22 local; errata reconciliation pending)",
          "title": "Source",
          "type": "string"
        },
        "supported_complete_domain": {
          "default": "Ordinary prismatic custom solid in concentric axial tension, with explicit external evidence",
          "title": "Supported Complete Domain",
          "type": "string"
        },
        "version": {
          "const": "HFS-010-v1",
          "default": "HFS-010-v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "source",
        "declared_scope",
        "supported_complete_domain",
        "method",
        "section_name",
        "profile_type",
        "scope_evidence",
        "evaluation_context",
        "demand_components",
        "obligations",
        "executions",
        "evaluation_errors",
        "external_responsibilities",
        "complete"
      ],
      "title": "CoverageReport",
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "kind",
    "payload"
  ],
  "title": "coverage_report contract 1.0 (validation)",
  "type": "object"
}
