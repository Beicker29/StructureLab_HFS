{
  "$comment": "Finite JSON only. Validate with steel_design.contracts for canonical cross-field and derived/evidence integrity. Dynamic details are opaque JSON, not an accredited normative trace.",
  "$defs": {
    "CheckStatus": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "title": "CheckStatus",
      "type": "string"
    }
  },
  "$id": "urn:structurelab-hfs:contracts:1.0:check_result:serialization",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "type": "string"
    },
    "kind": {
      "const": "check_result",
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "description": "Original unrounded available strength (phi*Rn or Rn/Omega)",
          "title": "Capacity",
          "type": "number"
        },
        "clause": {
          "description": "Code clause (e.g., F2-1)",
          "title": "Clause",
          "type": "string"
        },
        "code": {
          "default": "AISC 360-22",
          "description": "Reference code",
          "title": "Code",
          "type": "string"
        },
        "dcr": {
          "description": "Original unrounded ratio used for the decision; not a display value",
          "title": "Dcr",
          "type": "number"
        },
        "demand": {
          "description": "Original unrounded required strength",
          "title": "Demand",
          "type": "number"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured rule details (e.g., element classification).",
          "title": "Details"
        },
        "display": {
          "additionalProperties": true,
          "readOnly": true,
          "title": "Display",
          "type": "object"
        },
        "name": {
          "description": "Name of the check (e.g., Flexure Major F2)",
          "title": "Name",
          "type": "string"
        },
        "numeric_issue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Issue"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus",
          "description": "PASS or FAIL status"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "kN",
                "kN-m",
                "ratio"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "code",
        "clause",
        "demand",
        "capacity",
        "dcr",
        "unit",
        "numeric_issue",
        "status",
        "details",
        "display"
      ],
      "title": "CheckResult",
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "kind",
    "payload"
  ],
  "title": "check_result contract 1.0 (serialization)",
  "type": "object"
}
